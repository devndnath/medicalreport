APP_NAME="Factory Medicine Inventory & Expense System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicare_erp
DB_USERNAME=root
DB_PASSWORD=

# For quick local evaluation without MySQL, you can switch to:
# DB_CONNECTION=sqlite
# and remove the DB_HOST/PORT/DATABASE/USERNAME/PASSWORD lines above.

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database

CURRENCY_CODE=BDT
CURRENCY_SYMBOL="৳"
DATE_FORMAT="d-m-Y"

LOW_STOCK_DEFAULT_THRESHOLD_DAYS=30
EXPIRY_ALERT_DAYS=90
